MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="usvc"
FRONTEND_URL="http://localhost:3000"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
  STRIPE_SECRET_KEY="sk_test_..."
  STRIPE_WEBHOOK_SECRET="whsec_..."
  STRIPE_PUBLISHABLE_KEY="pk_test_..."
  # Fail-safe payment mode: "test" requires test keys, "live" requires live
  # keys. Never infer from NODE_ENV. Set "live" only in production.
  PAYMENT_ENVIRONMENT="test"
  # Incoming webhook URL of the Google Chat space for paid-order alerts.
  # Unset disables alerts. Never commit the real URL.
  # GOOGLE_CHAT_WEBHOOK_URL="https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=..."
EMAIL_ENABLED="false"
RESEND_API_KEY="re_..."
EMAIL_FROM="US Vital Certificates <noreply@usvitalcertificates.org>"
EMAIL_REPLY_TO="support@usvitalcertificates.org"
# Origin of the staff portal for invitation setup links. Production:
# https://flow.usvitalcertificates.org — staging: https://staging.usvitalcertificates.org
# Required when EMAIL_ENABLED="true".
STAFF_PORTAL_URL="http://localhost:3000"
# Staging only. Leave unset in production.
EMAIL_RECIPIENT_OVERRIDE="internal-test-inbox@example.com"
# Encrypted confidentialData (SSN + card) at rest. 64-char hex or base64 of 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real key. Backend fails closed at startup when missing/malformed.
# SENSITIVE_ENCRYPTION_KEY="..."
SENSITIVE_KEY_ID="v1"
ANALYTICS_ENABLED="false"
GA_MEASUREMENT_ID="G-GM4PWPHER1"
# Required only when ANALYTICS_ENABLED="true". Never commit the secret.
# GA4_MEASUREMENT_PROTOCOL_API_SECRET="..."
OPENAI_CONVERSIONS_ENABLED="false"
OPENAI_ADS_PIXEL_ID="YOUR_PIXEL_ID"
OPENAI_CONVERSION_SOURCE_URL="https://example.com/order/confirmation"
# Required only when OPENAI_CONVERSIONS_ENABLED="true". Never commit the secret.
# OPENAI_CONVERSIONS_API_KEY="..."
